{
  "policies": [
    {
      "displayName": "Serverless Felix - Cloud Run 5xx Spike ({{ENV}})",
      "documentation": {
        "mimeType": "text/markdown",
        "content": "Cloud Run 5xx rate is above threshold across Serverless Felix services in `{{PROJECT_ID}}`."
      },
      "userLabels": {
        "app": "serverless-felix",
        "env": "{{ENV}}",
        "managed_by": "codex"
      },
      "conditions": [
        {
          "displayName": "Total 5xx rate > 0.05 errors/s for 5m",
          "conditionThreshold": {
            "filter": "metric.type=\"run.googleapis.com/request_count\" resource.type=\"cloud_run_revision\" metric.labels.response_code_class=\"5xx\" (resource.labels.service_name=\"discordproxy\" OR resource.labels.service_name=\"webproxy\" OR resource.labels.service_name=\"oauthproxy\" OR resource.labels.service_name=\"workerdraw\" OR resource.labels.service_name=\"workerdiscord\" OR resource.labels.service_name=\"workeroauth\" OR resource.labels.service_name=\"workersnapshot\" OR resource.labels.service_name=\"workerwebread\")",
            "aggregations": [
              {
                "alignmentPeriod": "60s",
                "perSeriesAligner": "ALIGN_RATE",
                "crossSeriesReducer": "REDUCE_SUM"
              }
            ],
            "comparison": "COMPARISON_GT",
            "thresholdValue": 0.05,
            "duration": "300s",
            "trigger": {
              "count": 1
            }
          }
        }
      ],
      "combiner": "OR",
      "enabled": true,
      "alertStrategy": {
        "autoClose": "1800s"
      }
    },
    {
      "displayName": "Serverless Felix - PubSub Backlog Depth ({{ENV}})",
      "documentation": {
        "mimeType": "text/markdown",
        "content": "Pub/Sub undelivered message backlog is above threshold for Serverless Felix worker subscriptions in `{{PROJECT_ID}}`."
      },
      "userLabels": {
        "app": "serverless-felix",
        "env": "{{ENV}}",
        "managed_by": "codex"
      },
      "conditions": [
        {
          "displayName": "Undelivered messages sum > 200 for 10m",
          "conditionThreshold": {
            "filter": "metric.type=\"pubsub.googleapis.com/subscription/num_undelivered_messages\" resource.type=\"pubsub_subscription\" resource.labels.subscription_id=monitoring.regex.full_match(\"eventarc-europe-west1-(workerdraw|workerdiscord|workeroauth|workersnapshot|workerwebread)-.*\")",
            "aggregations": [
              {
                "alignmentPeriod": "60s",
                "perSeriesAligner": "ALIGN_MEAN",
                "crossSeriesReducer": "REDUCE_SUM"
              }
            ],
            "comparison": "COMPARISON_GT",
            "thresholdValue": 200,
            "duration": "600s",
            "trigger": {
              "count": 1
            }
          }
        }
      ],
      "combiner": "OR",
      "enabled": true,
      "alertStrategy": {
        "autoClose": "1800s"
      }
    },
    {
      "displayName": "Serverless Felix - PubSub Oldest Unacked Age ({{ENV}})",
      "documentation": {
        "mimeType": "text/markdown",
        "content": "Pub/Sub oldest unacked message age is above threshold for Serverless Felix worker subscriptions in `{{PROJECT_ID}}`."
      },
      "userLabels": {
        "app": "serverless-felix",
        "env": "{{ENV}}",
        "managed_by": "codex"
      },
      "conditions": [
        {
          "displayName": "Oldest unacked age max > 120s for 10m",
          "conditionThreshold": {
            "filter": "metric.type=\"pubsub.googleapis.com/subscription/oldest_unacked_message_age\" resource.type=\"pubsub_subscription\" resource.labels.subscription_id=monitoring.regex.full_match(\"eventarc-europe-west1-(workerdraw|workerdiscord|workeroauth|workersnapshot|workerwebread)-.*\")",
            "aggregations": [
              {
                "alignmentPeriod": "60s",
                "perSeriesAligner": "ALIGN_MAX",
                "crossSeriesReducer": "REDUCE_MAX"
              }
            ],
            "comparison": "COMPARISON_GT",
            "thresholdValue": 120,
            "duration": "600s",
            "trigger": {
              "count": 1
            }
          }
        }
      ],
      "combiner": "OR",
      "enabled": true,
      "alertStrategy": {
        "autoClose": "1800s"
      }
    }
  ]
}
