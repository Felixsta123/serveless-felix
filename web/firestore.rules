rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow reading chunks and pixels for real-time canvas
    match /chunks/{chunkId}/pixels/{pixelId} {
      allow read: if true;
      allow write: if false; // Only backend workers can write
    }
    
    // Allow reading chunks collection
    match /chunks/{chunkId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Allow reading active area
    match /activeArea/{docId} {
      allow read: if true;
      allow write: if false;
    }
    
    // Sessions - no client access (backend only)
    match /sessions/{sessionId} {
      allow read, write: if false;
    }
    
    // All other collections - deny by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
